# ---------------------------------------------------------------------------
# Fas-Nav.ch – Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an.
# ---------------------------------------------------------------------------

# Datenbank (PostgreSQL)
# Bei Nutzung von docker-compose entspricht der Host dem Servicenamen "db".
DATABASE_URL="postgresql://fasnav:fasnav@localhost:5432/fasnav?schema=public"
POSTGRES_USER="fasnav"
POSTGRES_PASSWORD="fasnav"
POSTGRES_DB="fasnav"

# Auth.js / NextAuth
# Erzeuge ein Secret mit:  openssl rand -base64 32
AUTH_SECRET="bitte-ersetzen-openssl-rand-base64-32"
# Öffentliche Basis-URL der Anwendung (ohne abschliessenden Slash)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Hinter einem Reverse Proxy (nginx, Traefik) auf true setzen
AUTH_TRUST_HOST="true"

# Uploads / Storage
# STORAGE_DRIVER: local | s3
STORAGE_DRIVER="local"
UPLOAD_DIR="./public/uploads"
NEXT_PUBLIC_UPLOAD_BASE_URL="/uploads"
MAX_UPLOAD_SIZE_MB="8"

# Optional: S3 / Cloudflare R2 (nur bei STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# E-Mail (SMTP) – optional, ohne Konfiguration werden Mails nur geloggt
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="Fas-Nav.ch <noreply@fas-nav.ch>"
# Empfänger für Kontaktformular-Benachrichtigungen
CONTACT_NOTIFY_EMAIL="info@fas-nav.ch"

# Seed-Zugangsdaten (nur Entwicklung)
SEED_ADMIN_EMAIL="admin@fas-nav.ch"
SEED_ADMIN_PASSWORD="Fasnacht2027!"
SEED_TEAM_EMAIL="team@fas-nav.ch"
SEED_TEAM_PASSWORD="Fasnacht2027!"
SEED_ORG_PASSWORD="Fasnacht2027!"

# Merkwort für den täglichen Erinnerungslauf (Agenda-Erinnerungen).
# Muss mit dem gleichnamigen GitHub-Secret übereinstimmen. Erzeugen mit:
#   openssl rand -hex 32
# Ohne Wert lässt sich der Lauf nur von Hand im Dashboard auslösen.
CRON_SECRET=
